{
  "name": "vexboy",
  "version": "1.0.0",
  "description": "Analyze Convex function and schema usage in your codebase",
  "type": "module",
  "bin": {
    "vexboy": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/cli/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "dev:analyze": "tsx src/cli/index.ts analyze",
    "dev:schema": "tsx src/cli/index.ts schema",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "convex",
    "analysis",
    "usage",
    "schema",
    "cli",
    "developer-tools",
    "typescript"
  ],
  "license": "MIT",
  "author": "Lucas Knight"
}
